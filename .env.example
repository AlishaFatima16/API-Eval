# Copy to .env (or .env.local) for local development. NEVER commit real keys.

# Groq (OpenAI-compatible API) — get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: AI request timeout in milliseconds (default 25000)
# AI_TIMEOUT_MS=25000
